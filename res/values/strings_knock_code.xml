<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Screen lock picker entry. -->
    <string name="unlock_set_unlock_knock_code_title">Knock Code</string>

    <!-- Enrollment, first entry. -->
    <string name="knock_code_create_header">Create a Knock Code</string>
    <string name="knock_code_create_hint">Tap 4 to 8 times anywhere in the square, then tap Continue.</string>

    <!-- Enrollment, second entry. The sequence is entered once more so a typo cannot lock the
         user out of their own device. -->
    <string name="knock_code_confirm_header">Confirm your Knock Code</string>
    <string name="knock_code_confirm_hint">Tap the same sequence again.</string>

    <!-- The two entries did not match. -->
    <string name="knock_code_mismatch">The two Knock Codes did not match. Try again.</string>

    <!-- Below the 4-tap minimum, which exists because a 3-tap code has only 64 possible
         sequences and would be guessable in seconds. -->
    <string name="knock_code_too_short">Your Knock Code must be at least <xliff:g id="count">%1$d</xliff:g> taps long.</string>

    <string name="knock_code_continue">Continue</string>
    <string name="knock_code_confirm_button">Confirm</string>

    <!-- Accessibility label for the tap surface. -->
    <string name="knock_code_pad_description">Knock Code tap area</string>

</resources>
