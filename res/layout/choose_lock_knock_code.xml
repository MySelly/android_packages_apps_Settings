<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:sudAnimationIcon="@raw/icon_lock"
    android:icon="@drawable/ic_lock">

    <LinearLayout
        android:id="@+id/knock_code_container"
        style="@style/SudContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingRight="0dp">

        <!-- Takes the space left over between the header and the button, so the grid stays
             centred however tall the header text ends up being. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.android.settings.password.KnockCodePadView
                android:id="@+id/knock_code_pad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/knock_code_pad_description"/>

        </FrameLayout>

        <TextView
            android:id="@+id/knock_code_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/knock_code_continue"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:minWidth="160dp"
            android:text="@string/knock_code_continue"
            android:textAllCaps="false"/>

    </LinearLayout>

</com.google.android.setupdesign.GlifLayout>
